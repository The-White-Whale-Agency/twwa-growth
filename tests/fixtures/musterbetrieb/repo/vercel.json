{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/leistungen", "destination": "/#leistungen", "permanent": true },
    { "source": "/leistungen/fassade", "destination": "/#fassadensanierung", "permanent": true },
    { "source": "/kontakt", "destination": "/#kontakt", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "staging.musterbetrieb.example" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
